+// Klepton KL_MVK_MERGE_SUSPEND: a held encoder still open when its Metal command buffer
+// is committed means a suspended instance nobody resumed in this submission (invalid
+// Vulkan usage). Metal will not commit a command buffer with an encoder still open, so
+// end it; its store actions were never set and its contents are lost.
+void MVKCommandEncodingContext::abandonHeldRenderEncoder() {
+	if ( !heldRenderEncoder ) { return; }
+	mvkfov::logOnce("merge:abandon", "[mvk-merge] a suspended render pass instance was never resumed in its submission; its open encoder is ended without storing (logged once)\n");
