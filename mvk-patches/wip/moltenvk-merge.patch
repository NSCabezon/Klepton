+	if (left <= 0) { return; }
+	left--;
+	fprintf(stderr, "[mvk-merge] barrier between held segments (%zu): %s\n", count, why ? why : "kept in the open encoder");
+	for (size_t i = 0; i < count; i++) {
+		const auto& b = barriers[i];
+		fprintf(stderr, "[mvk-merge]   type %d src stage %#llx access %#llx -> dst stage %#llx access %#llx%s",
+				(int)b.type, (unsigned long long)b.srcStageMask, (unsigned long long)b.srcAccessMask,
+				(unsigned long long)b.dstStageMask, (unsigned long long)b.dstAccessMask, b.type == MVKPipelineBarrier::Image ? "" : "\n");
+		if (b.type == MVKPipelineBarrier::Image) {
