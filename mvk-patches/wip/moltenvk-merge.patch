+#pragma mark Klepton KL_MVK_MERGE_SUSPEND (suspended dynamic rendering in one Metal encoder)
+
+// Stock MoltenVK ends the Metal render encoder at every SUSPENDING vkCmdEndRendering
+// and starts a new one at the RESUMING vkCmdBeginRendering, so every attachment is
+// stored at the end of each segment and loaded back at the start of the next (Alyx's
+// scene pass: 4 segments x 2x/4x MSAA colour + D32S8, recorded on several threads).
+// Vulkan forbids action and synchronization commands between a suspended instance and
+// its resumption, so the encoder can stay open: the suspending command buffer hands it
+// to the submission's encoding context un-ended, and the resuming one continues in it.
+// Anything else touching Metal in between (or a different MTLCommandBuffer, queries,
+// prefill) ends it with the stock store actions — the stock path, nothing lost.
+
+bool MVKCommandEncoder::holdSuspendedRenderEncoder() {
+	if ( !mvkfov::isMergeSuspendEnabled() ) { return false; }
+	auto* ctx = _pEncodingContext;
+	const char* why = nullptr;
+	MVKRenderSubpass* sp = getSubpass();
+	if ( !_mtlRenderEncoder ) { why = "no open render encoder at the suspend"; }
+	else if (_cmdBuffer->_immediateCmdEncoder) { why = "prefilled command buffers"; }
+	else if (_cmdBuffer->_needsVisibilityResultMTLBuffer || _cmdBuffer->_hasStageCounterTimestampCommand) { why = "occlusion or timestamp queries"; }
+	else if ( !sp || (sp->isMultiview() && sp->getMultiviewMetalPassCount() != 1) ) { why = "multiview split into several Metal passes"; }
+	else if (ctx->heldRenderEncoder) { why = "an encoder is already held"; }
+	if (why) {
+		char key[96];
+		snprintf(key, sizeof(key), "merge:nohold:%s", why);
+		mvkfov::logOnce(key, "[mvk-merge] a suspending segment ends its encoder (stock store/load): %s (logged once)\n", why);
+		mvkfov::noteMerge(2, why);
+		return false;
+	}
+	ctx->heldRenderEncoder = _mtlRenderEncoder;
+	ctx->heldMTLCmdBuffer = _mtlCmdBuffer;
+	ctx->heldAttachments.assign(_attachments.begin(), _attachments.end());
+	ctx->heldIsRenderingEntireAttachment = _isRenderingEntireAttachment;
+	ctx->heldFov = _fov;
+	ctx->heldSerial = _ctxSerial;
+	_mtlRenderEncoder = nil;
+	mvkfov::logOnce("merge:first", "[mvk-merge] first suspending segment left open for its resumption\n");
+	mvkfov::noteMerge(0, nullptr);
+	return true;
+}
+
+bool MVKCommandEncoder::resumeHeldRenderEncoder(MVKCommand* rendCmd, const VkRenderingInfo* pRenderingInfo, VkSubpassContents contents,
+												MVKArrayRef<VkClearValue> clearValues, MVKArrayRef<MVKImageView*> attachments) {
+	auto* ctx = _pEncodingContext;
+	const char* why = nullptr;
+	if (ctx->heldMTLCmdBuffer != _mtlCmdBuffer) { why = "the resume is in another MTLCommandBuffer"; }
+	else if (_cmdBuffer->_immediateCmdEncoder || _cmdBuffer->_needsVisibilityResultMTLBuffer || _cmdBuffer->_hasStageCounterTimestampCommand) {
+		why = "queries or prefill in the resuming command buffer";
+	} else if (_mtlRenderEncoder || _mtlComputeEncoder || _mtlBlitEncoder) { why = "an encoder is open at the resume"; }
+	else if (attachments.size() != ctx->heldAttachments.size()) { why = "different attachments"; }
+	else {
+		for (size_t i = 0; i < attachments.size(); i++) {
+			if (attachments[i] != ctx->heldAttachments[i]) { why = "different attachments"; break; }
+		}
+	}
+	if (why) {
+		flushHeldRenderEncoder(why);
+		return false;
+	}
+
+	MVKRenderPass* mvkRP = ctx->getRenderPass();
+	mvkRP->setRenderingFlags(pRenderingInfo->flags);
+
+	// What beginRenderpass() and setSubpass() set up, minus a new Metal render pass.
+	_renderArea = pRenderingInfo->renderArea;
+	_isRenderingEntireAttachment = ctx->heldIsRenderingEntireAttachment;
+	ctx->heldAreaEntireValid = mvkIsAnyFlagEnabled(pRenderingInfo->flags, VK_RENDERING_SUSPENDING_BIT);
+	_clearValues.assign(clearValues.begin(), clearValues.end());
+	_attachments.assign(attachments.begin(), attachments.end());
+	_fov = ctx->heldFov;
+	_lastMultiviewPassCmd = rendCmd;
+	_subpassContents = contents;
+	_renderSubpassIndex = 0;
+	_multiviewPassIndex = 0;
+	auto& mtlFeats = getMetalFeatures();
+	_canUseLayeredRendering = mtlFeats.layeredRendering && (mtlFeats.multisampleLayeredRendering || getSubpass()->getSampleCount() == VK_SAMPLE_COUNT_1_BIT);
+
+	_mtlRenderEncoder = ctx->heldRenderEncoder;
+	ctx->heldRenderEncoder = nil;
+	ctx->heldMTLCmdBuffer = nil;
+	ctx->heldAttachments.clear();
+	ctx->heldFov.reset();
+	// A new command buffer binds everything again: start the Metal-side tracking clean.
+	getState().beginGraphicsEncoding(getSampleCount());
+	mvkfov::noteMerge(1, nullptr);
+	return true;
+}
+
+id<MTLRenderCommandEncoder> MVKCommandEncoder::getIdleHeldRenderEncoder() {
+	if ( !_pEncodingContext || _mtlRenderEncoder || _mtlComputeEncoder || _mtlBlitEncoder ) { return nil; }
+	return _pEncodingContext->heldRenderEncoder;
+}
+
+bool MVKCommandEncoder::isHeldAttachmentImage(MVKImage* image) {
+	if ( !_pEncodingContext || !image ) { return false; }
+	for (auto* iv : _pEncodingContext->heldAttachments) {
+		if (iv && iv->getImage() == image) { return true; }
+	}
+	return false;
+}
