+void MVKCommandEncoder::traceHeldBarrier(size_t count, const MVKPipelineBarrier* barriers, const char* why) {
+	static int left = -1;
+	if (left < 0) { const char* e = getenv("KL_MVK_MERGE_DEBUG"); left = (e && *e && *e != '0') ? 16 : 0; }
+	if (left <= 0) { return; }
+	left--;
+	fprintf(stderr, "[mvk-merge] barrier between held segments (%zu): %s\n", count, why ? why : "kept in the open encoder");
+	for (size_t i = 0; i < count; i++) {
+		const auto& b = barriers[i];
+		fprintf(stderr, "[mvk-merge]   type %d src stage %#llx access %#llx -> dst stage %#llx access %#llx%s",
+				(int)b.type, (unsigned long long)b.srcStageMask, (unsigned long long)b.srcAccessMask,
+				(unsigned long long)b.dstStageMask, (unsigned long long)b.dstAccessMask, b.type == MVKPipelineBarrier::Image ? "" : "\n");
+		if (b.type == MVKPipelineBarrier::Image) {
+			fprintf(stderr, " image %p (%ux%u x%u samples %u) layout %d -> %d%s\n", (void*)b.mvkImage,
+					b.mvkImage->getExtent3D().width, b.mvkImage->getExtent3D().height, b.mvkImage->getLayerCount(),
+					(unsigned)b.mvkImage->getSampleCount(), (int)b.mvkImage->klGetLayout(b.baseMipLevel, b.baseArrayLayer),
+					(int)b.newLayout, isHeldAttachmentImage(b.mvkImage) ? " [held attachment]" : "");
+		}
+	}
+}
+
+bool MVKCommandEncoder::isCurrentAttachmentImage(MVKImage* image) {
+	if ( !image ) { return false; }
+	for (auto* iv : _attachments) {
+		if (iv && iv->getImage() == image) { return true; }
+	}
+	return false;
+}
