+	_occlusionQueryState.klDetachForHold(this, _mtlRenderEncoder, ctx->heldOcclusion);
+	{
+		auto& g = getState().mtlGraphics();
+		ctx->heldNumSamplePositions = std::min<uint8_t>(g._numSamplePositions, kMVKMaxSampleCount);
+		mvkCopy(ctx->heldSamplePositions, g._samplePositions, ctx->heldNumSamplePositions);
+		ctx->heldSamplePositionsOverridden = g._flags.has(MVKMetalRenderEncoderStateFlag::SamplePositionsOverridden);
+	}
+	_mtlRenderEncoder = nil;
+	mvkfov::logOnce("merge:first", "[mvk-merge] first suspending segment left open for its resumption\n");
+	mvkfov::noteMerge(0, nullptr);
+	return true;
+}
+
+bool MVKCommandEncoder::resumeHeldRenderEncoder(MVKCommand* rendCmd, const VkRenderingInfo* pRenderingInfo, VkSubpassContents contents,
+												MVKArrayRef<VkClearValue> clearValues, MVKArrayRef<MVKImageView*> attachments) {
+	auto* ctx = _pEncodingContext;
+	const char* why = nullptr;
+	if (ctx->heldMTLCmdBuffer != _mtlCmdBuffer) { why = "the resume is in another MTLCommandBuffer"; }
+	else if (_cmdBuffer->_immediateCmdEncoder || _cmdBuffer->_hasStageCounterTimestampCommand) {
+		why = "timestamp queries or prefill in the resuming command buffer";
+	} else if (_cmdBuffer->_needsVisibilityResultMTLBuffer && !ctx->heldHasViz) {
+		why = "occlusion queries in the resuming command buffer, none in the open encoder";
+	} else if ( !_occlusionQueryState.klCanAdopt(ctx->heldOcclusion) ) {
+		why = "occlusion-query copy fences full";
+	} else if (_mtlRenderEncoder || _mtlComputeEncoder || _mtlBlitEncoder) { why = "an encoder is open at the resume"; }
+	else if (attachments.size() != ctx->heldAttachments.size()) { why = "different attachments"; }
+	else {
+		for (size_t i = 0; i < attachments.size(); i++) {
+			if (attachments[i] != ctx->heldAttachments[i]) { why = "different attachments"; break; }
+		}
+	}
+	if (why) {
+		flushHeldRenderEncoder(why);
+		return false;
+	}
+
+	MVKRenderPass* mvkRP = ctx->getRenderPass();
+	mvkRP->setRenderingFlags(pRenderingInfo->flags);
+
+	// What beginRenderpass() and setSubpass() set up, minus a new Metal render pass.
+	_renderArea = pRenderingInfo->renderArea;
+	_isRenderingEntireAttachment = ctx->heldIsRenderingEntireAttachment;
+	ctx->heldAreaEntireValid = mvkIsAnyFlagEnabled(pRenderingInfo->flags, VK_RENDERING_SUSPENDING_BIT);
+	_clearValues.assign(clearValues.begin(), clearValues.end());
+	_attachments.assign(attachments.begin(), attachments.end());
+	_fov = ctx->heldFov;
+	_lastMultiviewPassCmd = rendCmd;
+	_subpassContents = contents;
+	_renderSubpassIndex = 0;
+	_multiviewPassIndex = 0;
+	auto& mtlFeats = getMetalFeatures();
+	_canUseLayeredRendering = mtlFeats.layeredRendering && (mtlFeats.multisampleLayeredRendering || getSubpass()->getSampleCount() == VK_SAMPLE_COUNT_1_BIT);
+
+	_mtlRenderEncoder = ctx->heldRenderEncoder;
+	_klRPHasViz = ctx->heldHasViz;
+	_klRPColorMask = ctx->heldColorMask;
+	_klRPColorMemoryless = ctx->heldColorMemoryless;
+	_klRPDSMask = ctx->heldDSMask;
+	_occlusionQueryState.klAdoptHeld(ctx->heldOcclusion);	// accumulated when the merged encoder ends
+	ctx->heldRenderEncoder = nil;
+	ctx->heldMTLCmdBuffer = nil;
+	ctx->heldAttachments.clear();
+	ctx->heldFov.reset();
+	// A new command buffer binds everything again: start the Metal-side tracking clean.
+	getState().beginGraphicsEncoding(getSampleCount());
+	// The encoder's sample positions are the holder's, not whatever this MVKCommandEncoder
+	// last used: without this, a resuming command buffer that never began a Metal render
+	// pass compares against 0 positions and restarts the pass (store + load) at its first draw.
+	{
+		auto& g = getState().mtlGraphics();
+		g._numSamplePositions = ctx->heldNumSamplePositions;
+		mvkCopy(g._samplePositions, ctx->heldSamplePositions, ctx->heldNumSamplePositions);
+		g._flags.set(MVKMetalRenderEncoderStateFlag::SamplePositionsOverridden, ctx->heldSamplePositionsOverridden);
+	}
+	mvkfov::noteMerge(1, nullptr);
+	return true;
+}
+
+id<MTLRenderCommandEncoder> MVKCommandEncoder::getIdleHeldRenderEncoder() {
+	if ( !_pEncodingContext || _mtlRenderEncoder || _mtlComputeEncoder || _mtlBlitEncoder ) { return nil; }
+	return _pEncodingContext->heldRenderEncoder;
+}
