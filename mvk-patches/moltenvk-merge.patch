+// Klepton KL_MVK_MERGE_SUSPEND (see MVKCommandEncoderState.h).
+void MVKOcclusionQueryCommandEncoderState::klDetachForHold(MVKCommandEncoder* cmdEncoder, id<MTLRenderCommandEncoder> mtlEnc,
+															MVKOcclusionQueryCommandEncoderState& into) {
+	if (_metalVisibilityResultMode != MTLVisibilityResultModeDisabled) {
+		// Close the last Metal query of this segment and stop counting in the encoder, so the
+		// next segment's draws (its state starts "disabled") never write into this slot.
+		nextMetalQuery(cmdEncoder);
+		[mtlEnc setVisibilityResultMode: MTLVisibilityResultModeDisabled
+		                         offset: cmdEncoder->_pEncodingContext->visibilityResultBuffer.offset()];
+	}
+	_metalVisibilityResultMode = MTLVisibilityResultModeDisabled;
+	into.klAdoptHeld(*this);
+}
+
+bool MVKOcclusionQueryCommandEncoderState::klCanAdopt(const MVKOcclusionQueryCommandEncoderState& other) const {
+	uint32_t n = _numCopyFences;
+	for (uint32_t i = 0; i < other._numCopyFences; i++) {
+		bool dup = false;
+		for (uint32_t j = 0; j < _numCopyFences; j++) { dup |= (_copyFences[j].write == other._copyFences[i].write); }
+		if ( !dup ) { n++; }
+	}
+	return n <= std::size(_copyFences);
+}
+
+void MVKOcclusionQueryCommandEncoderState::klAdoptHeld(MVKOcclusionQueryCommandEncoderState& other) {
+	for (auto& q : other._mtlRenderPassQueries) { _mtlRenderPassQueries.push_back(q); }
+	for (uint32_t i = 0; i < other._numCopyFences; i++) {
+		bool dup = false;
+		for (uint32_t j = 0; j < _numCopyFences; j++) { dup |= (_copyFences[j].write == other._copyFences[i].write); }
+		if ( !dup && _numCopyFences < std::size(_copyFences) ) { _copyFences[_numCopyFences++] = other._copyFences[i]; }
+	}
+	_shouldAccumulate |= other._shouldAccumulate;
+	if (other._lastFenceUpdate) { _lastFenceUpdate = other._lastFenceUpdate; }
+	_metalVisibilityResultMode = MTLVisibilityResultModeDisabled;
+	other.klClear();
+}
+
+void MVKOcclusionQueryCommandEncoderState::klDropQueries(MVKOcclusionQueryPool* pool, uint32_t firstQuery, uint32_t queryCount) {
+	size_t w = 0;
+	for (size_t r = 0; r < _mtlRenderPassQueries.size(); r++) {
+		auto& q = _mtlRenderPassQueries[r];
+		if (q.queryPool == pool && q.query >= firstQuery && q.query < firstQuery + queryCount) { continue; }
+		if (w != r) { _mtlRenderPassQueries[w] = q; }
+		w++;
+	}
+	while (_mtlRenderPassQueries.size() > w) { _mtlRenderPassQueries.pop_back(); }
+}
