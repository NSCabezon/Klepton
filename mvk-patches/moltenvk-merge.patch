+bool MVKCommandEncoder::isHeldAttachmentImage(MVKImage* image) {
+	if ( !_pEncodingContext || !image ) { return false; }
+	for (auto* iv : _pEncodingContext->heldAttachments) {
+		if (iv && iv->getImage() == image) { return true; }
+	}
+	return false;
+}
