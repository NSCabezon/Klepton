+// Klepton KL_MVK_MERGE_SUSPEND: a held encoder still open when its Metal command buffer
+// is committed means a suspended instance nobody resumed in this submission (invalid
+// Vulkan usage). Metal will not commit a command buffer with an encoder still open, so
+// end it; its store actions were never set and its contents are lost.
+void MVKCommandEncodingContext::abandonHeldRenderEncoder() {
+	if ( !heldRenderEncoder ) { return; }
+	mvkfov::logOnce("merge:abandon", "[mvk-merge] a suspended render pass instance was not resumed before its MTLCommandBuffer was committed; its open encoder is ended with plain store actions (logged once)\n");
+	// The stock end of a suspending segment, without an MVKCommandEncoder: store every
+	// attachment (a memoryless one cannot be: don't care) so a resumption in a later
+	// MTLCommandBuffer loads what was drawn.
+	for (uint32_t i = 0; i < 8; i++) {
+		if (heldColorMask & (1u << i)) {
+			[heldRenderEncoder setColorStoreAction: (heldColorMemoryless & (1u << i)) ? MTLStoreActionDontCare : MTLStoreActionStore atIndex: i];
+		}
+	}
+	if (heldDSMask & 1) { [heldRenderEncoder setDepthStoreAction: (heldDSMask & 4) ? MTLStoreActionDontCare : MTLStoreActionStore]; }
+	if (heldDSMask & 2) { [heldRenderEncoder setStencilStoreAction: (heldDSMask & 8) ? MTLStoreActionDontCare : MTLStoreActionStore]; }
+	[heldRenderEncoder endEncoding];
+	heldOcclusion.klClear();	// their results are lost (no encoder to accumulate them in)
+	heldRenderEncoder = nil;
+	heldMTLCmdBuffer = nil;
+	heldAttachments.clear();
+	heldFov.reset();
+	// No encoder to put the deferred query resets in: zero them from the CPU.
+	for (auto& r : pendingQueryResets) {
+		NSUInteger end = std::min<NSUInteger>(r.offset + r.length, r.buffer.length);
+		if (r.buffer.contents && end > r.offset) { mvkClear((char*)r.buffer.contents + r.offset, end - r.offset); }
+	}
+	pendingQueryResets.clear();
+	mvkfov::noteMerge(2, "never resumed");
+}
