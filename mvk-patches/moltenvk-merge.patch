+	if (left <= 0) { return; }
+	left--;
+	fprintf(stderr, "[mvk-merge] in-pass barrier restarts the Metal pass (%zu barriers, dep flags %#x, rendering flags %#x, %zu attachments):\n",
+			count, (unsigned)depFlags, (unsigned)_pEncodingContext->getRenderingFlags(), _attachments.size());
