+}
+
+bool MVKCommandEncoder::deferQueryResetWhileHeld(MVKOcclusionQueryPool* pool, uint32_t firstQuery, uint32_t queryCount,
+												 id<MTLBuffer> buffer, NSUInteger offset, NSUInteger length) {
+	if ( !buffer || !getIdleHeldRenderEncoder() ) { return false; }
+	// Results the held segments already produced for these queries are what the reset discards.
+	_pEncodingContext->heldOcclusion.klDropQueries(pool, firstQuery, queryCount);
+	_pEncodingContext->pendingQueryResets.push_back({ buffer, offset, length });
+	return true;
+}
+
+void MVKCommandEncoder::encodePendingQueryResets() {
+	auto* ctx = _pEncodingContext;
+	if ( !ctx || ctx->pendingQueryResets.empty() || ctx->heldRenderEncoder ) { return; }
+	MVKSmallVector<MVKCommandEncodingContext::PendingQueryReset, 4> resets;
+	for (auto& r : ctx->pendingQueryResets) { resets.push_back(r); }
+	ctx->pendingQueryResets.clear();
+	id<MTLBlitCommandEncoder> blitEncoder = getMTLBlitEncoder(kMVKCommandUseResetQueryPool);
+	for (auto& r : resets) {
+		[blitEncoder fillBuffer: r.buffer range: NSMakeRange(r.offset, r.length) value: 0];
+	}
+}
+
+void MVKCommandEncoder::flushHeldRenderEncoder(const char* why) {
+	auto* ctx = _pEncodingContext;
+	if ( !ctx || !ctx->heldRenderEncoder ) { return; }
+	id<MTLRenderCommandEncoder> held = ctx->heldRenderEncoder;
+	ctx->heldRenderEncoder = nil;
+
+	// The stock end of a suspending segment: store every attachment for the resumption.
+	id<MTLRenderCommandEncoder> mine = _mtlRenderEncoder;
+	_mtlRenderEncoder = held;
+	MVKRenderPass* rp = ctx->getRenderPass();
+	if (rp) { rp->getSubpass(0)->encodeStoreActions(this, ctx->heldIsRenderingEntireAttachment, ctx->heldAttachments.contents(), true); }
+	barrierUpdate(kMVKBarrierStageVertex, held, MTLRenderStageVertex);
+	barrierUpdate(kMVKBarrierStageFragment, held, MTLRenderStageFragment);
+	[held endEncoding];
+	_mtlRenderEncoder = mine;
+	encodePendingQueryResets();
+	// The held segments' occlusion results: accumulated now, as the stock end of the pass would have.
+	if (ctx->heldOcclusion.klHasPendingQueries()) {
+		_occlusionQueryState.klAdoptHeld(ctx->heldOcclusion);
+		_occlusionQueryState.endMetalRenderPass(this);
+	}
+	ctx->heldOcclusion.klClear();
+
+	ctx->heldMTLCmdBuffer = nil;
+	ctx->heldAttachments.clear();
+	ctx->heldFov.reset();
+	// KL_MVK_MERGE_DEBUG=1: who ended it (the first 8 times), to find what an app does between segments.
+	static int dbg = -1;
+	if (dbg < 0) { const char* e = getenv("KL_MVK_MERGE_DEBUG"); dbg = (e && *e && *e != '0') ? 8 : 0; }
+	if (dbg > 0) {
+		dbg--;
+		void* frames[12];
+		int n = backtrace(frames, 12);
+		fprintf(stderr, "[mvk-merge] flush (%s) from:\n", why);
+		backtrace_symbols_fd(frames, n, 2);
+	}
+	char key[128];
+	snprintf(key, sizeof(key), "merge:flush:%s", why);
+	mvkfov::logOnce(key, "[mvk-merge] an open suspended encoder was ended with store actions: %s (logged once)\n", why);
+	mvkfov::noteMerge(2, why);
+}
